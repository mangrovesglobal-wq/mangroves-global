# ── Backend API ──────────────────────────────────────────────────────────────
# Base URL of the Laravel backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=https://api.mangrovesglobal.com

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Get from: Google Analytics → Admin → Data Streams → Measurement ID
# Format: G-XXXXXXXXXX
# Note: Leave blank if you use GTM to fire GA4 (avoids double-counting).
NEXT_PUBLIC_GA4_ID=

# ── Google Tag Manager ───────────────────────────────────────────────────────
# Get from: tagmanager.google.com → Admin → Container ID
# Format: GTM-XXXXXXX
# When set, GTM loads instead of raw GA4 (GA4 fires through GTM).
NEXT_PUBLIC_GTM_ID=

# ── Google Search Console verification ───────────────────────────────────────
# Get from: Search Console → Settings → Ownership verification → HTML tag
# Copy only the content="..." value, not the full <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Bing Webmaster Tools verification ────────────────────────────────────────
# Get from: Bing Webmaster Tools → Settings → Site Verification → Meta Tag
# Copy only the content="..." value.
NEXT_PUBLIC_BING_VERIFICATION=

# ── IndexNow ─────────────────────────────────────────────────────────────────
# Get from: Bing Webmaster Tools → IndexNow → Generate key
# After getting the key:
#   1. Add it here as INDEXNOW_KEY=your-key
#   2. Create public/{your-key}.txt containing just the key on one line
#   3. Submit URLs: POST /api/indexnow (no auth needed from your server)
#   4. Ping a single page: GET /api/indexnow?url=https://mangrovesglobal.com/page
# This is a server-only secret — do NOT prefix with NEXT_PUBLIC_.
INDEXNOW_KEY=
